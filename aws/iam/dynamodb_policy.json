{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Scan",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:*:*:table/Employees",
        "arn:aws:dynamodb:*:*:table/LeaveRequests",
        "arn:aws:dynamodb:*:*:table/Employees/index/*",
        "arn:aws:dynamodb:*:*:table/LeaveRequests/index/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["sns:Publish"],
      "Resource": ["*"]
    }
  ]
}
